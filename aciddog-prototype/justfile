# Top-level justfile for aciddog.

[default, private]
main:
	@just --list

# Compile the binary
[group('app')]
app-build:
	cargo build

# Type-check without building
[group('app')]
app-check:
	cargo check --all-targets

# Run clippy with warnings as errors
[group('app')]
app-lint:
	cargo clippy --all-targets -- -D warnings

# Format the codebase
[group('app')]
app-fmt:
	cargo fmt

# Verify formatting without modifying
[group('app')]
app-fmt-check:
	cargo fmt -- --check

# Run unit tests (lib only)
[group('app')]
app-test-unit:
	cargo test --lib

# Run integration tests (tests/)
[group('app')]
app-test-integration:
	cargo test --test '*'

# Run all tests
[group('app')]
app-test: app-test-unit app-test-integration

# Install wcl/aciddog.wcl into ${XDG_DATA_HOME:-$HOME/.local/share}/wcl/lib/ so demos can `import <aciddog.wcl>`
[group('wcl')]
wcl-schema-install:
	mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/wcl/lib"
	cp wcl/aciddog.wcl "${XDG_DATA_HOME:-$HOME/.local/share}/wcl/lib/aciddog.wcl"

# Start the TUI in the demo workspace
[group('run')]
run: wcl-schema-install
	cd demo && cargo run --manifest-path ../crates/aciddog/Cargo.toml

# Headless aciddog (no TUI) in demo/ — drive via aciddog-manager
[group('run')]
run-daemon: wcl-schema-install
	cd demo && cargo run --manifest-path ../crates/aciddog/Cargo.toml -- daemon

# Remote-demo server side: :webservice on /tmp/aciddog-remote-demo.sock (pair with `run-remote-client`)
[group('run')]
run-remote-server: wcl-schema-install
	cd demo-remote-server && cargo run --manifest-path ../crates/aciddog/Cargo.toml

# Headless remote-demo server (no TUI) — drive via aciddog-manager over unix:/tmp/aciddog-remote-demo.sock
[group('run')]
run-remote-server-daemon: wcl-schema-install
	cd demo-remote-server && cargo run --manifest-path ../crates/aciddog/Cargo.toml -- daemon

# Remote-demo client side: :remote dialing the server's socket (start the server first or watch it retry)
[group('run')]
run-remote-client: wcl-schema-install
	cd demo-remote-client && cargo run --manifest-path ../crates/aciddog/Cargo.toml

MANAGER_MANIFEST := "crates/aciddog-manager/Cargo.toml"

# Install the manager's frontend dependencies (first-time setup)
[group('manager')]
manager-frontend-install:
	cd crates/aciddog-manager/web && npm install

# Build the SolidJS frontend into crates/aciddog-manager/web/dist/
[group('manager')]
manager-frontend-build:
	cd crates/aciddog-manager/web && npm run build

# Build the manager binary (frontend included)
[group('manager')]
manager-build: manager-frontend-build
	cargo build --manifest-path {{MANAGER_MANIFEST}}

# Type-check the manager crate
[group('manager')]
manager-check: manager-frontend-build
	cargo check --manifest-path {{MANAGER_MANIFEST}} --all-targets

# Lint the manager crate with warnings-as-errors
[group('manager')]
manager-lint: manager-frontend-build
	cargo clippy --manifest-path {{MANAGER_MANIFEST}} --all-targets -- -D warnings

# Format-check the manager crate
[group('manager')]
manager-fmt-check:
	cargo fmt --manifest-path {{MANAGER_MANIFEST}} -- --check

# Format the manager crate
[group('manager')]
manager-fmt:
	cargo fmt --manifest-path {{MANAGER_MANIFEST}}

# Run the manager's test suite
[group('manager')]
manager-test: manager-frontend-build
	cargo test --manifest-path {{MANAGER_MANIFEST}}

# Run the manager frontend Vitest suite
[group('manager')]
manager-frontend-test: manager-frontend-install
	cd crates/aciddog-manager/web && npm test

# Opt-in browser smoke suite; see docs/mobile.md for seed/admin setup.
[group('manager')]
manager-frontend-e2e: manager-frontend-build
	cd crates/aciddog-manager/web && npm run test:e2e:install && npm run test:e2e

# Launch the manager on 127.0.0.1:7000 with a deterministic test/test admin
[group('run')]
run-manager: manager-frontend-build
	cargo run --manifest-path {{MANAGER_MANIFEST}} -- reset-password --username test --password test
	cargo run --manifest-path {{MANAGER_MANIFEST}}

# Build everything
[group('build')]
build: manager-frontend-install manager-frontend-build app-build manager-build

# Build aciddog (release) and install via `cargo install --path`
[group('install')]
app-install:
	cargo install --path crates/aciddog --force

# Build the manager (frontend embedded, release) and install via `cargo install --path`
[group('install')]
manager-install: manager-frontend-build
	cargo install --path crates/aciddog-manager --force

# Build and install aciddog + aciddog-manager (release) into $CARGO_HOME/bin and install the WCL schema
[group('install')]
install: manager-frontend-install manager-frontend-build app-install manager-install wcl-schema-install

# Run every test
[group('test')]
test: manager-frontend-install app-test manager-test manager-frontend-test

# Full CI pipeline: fmt check, lint, tests (app + manager)
[group('ci')]
ci: manager-frontend-install app-fmt-check app-lint app-test manager-fmt-check manager-lint manager-test

# Stamp a version string into both Cargo.toml files and the web package.json. Used by the release workflow before building.
[group('release')]
version-set ver:
	sed -i 's/^version = "[^"]*"/version = "{{ver}}"/' crates/aciddog/Cargo.toml
	sed -i 's/^version = "[^"]*"/version = "{{ver}}"/' crates/aciddog-manager/Cargo.toml
	sed -i 's/^  "version": "[^"]*"/  "version": "{{ver}}"/' crates/aciddog-manager/web/package.json
