# Copy this file to `demo/.env` (it's gitignored) and fill in real
# values. `aciddog` loads `.env` from the current working directory at
# startup, so run the TUI from this directory for these to take effect.

# API key for the Z.ai Anthropic-compatible endpoint used by the
# `z_ai` ai_core block in aciddog.wcl. The variable name must match
# the `apiKeyEnv` field on that block.
ZAI_API_KEY=

# API key for the OpenRouter endpoint used by the `openrouter` ai_core
# block in aciddog.wcl (via the openAiApi variant). The variable name
# must match the `apiKeyEnv` field on that block. Used by the
# `jokemaster` agent.
OPENROUTER_API_KEY=

# If you also want to run the native Anthropic API alongside, add the
# matching core block in aciddog.wcl and put your key here:
# ANTHROPIC_API_KEY=
#
# If you want to run against api.openai.com directly, change the
# `apiUrl`/`model` fields on a copy of the `openrouter` core block and
# put your key here:
# OPENAI_API_KEY=
