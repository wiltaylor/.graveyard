// A reusable procedure with typed inputs and sequential steps. Trigger
// it from the TUI's Workflows panel (or via `/run <id>`) and the engine
// spawns a per-instance task. Today only `command` and `check` steps
// run; `worker` and `conditional` steps are wired in follow-up tasks.
workflow smoke {
  description = "Smoke-test the workflow engine with a command + gate."
  max_retries = 2

  // Visible inputs: the user fills these in the form (once shipped).
  property branch { kind = :text default = "main" }
  property suites { kind = :multiSelect options = ["unit","integ"] default = ["unit"] }

  // Single-choice Select: click the row to open a dropdown picker, or
  // use ←/→ to cycle and Enter to open.
  property environment {
    kind    = :select
    options = ["dev","staging","prod"]
    default = "dev"
  }

  // Hidden variables are never shown in the form. They're seeded from
  // `default` at instance start and mutated at runtime by workers via
  // `workflow_set` (tool wiring ships in a later task).
  property last_check { kind = :hidden default = "ok" }

  // $$VAR$$ substitution fires at step start with a live snapshot of
  // the variable map.
  step echo  { kind = :command command = "echo ran on $$branch$$ env=$$environment$$ suites=$$suites$$" }

  // 30-second sleep so the instance is visible in the sidebar long
  // enough to observe progress (echo + check + echo would otherwise
  // finish in milliseconds and flash by).
  step wait  { kind = :command command = "sleep 30" }

  // Pure variable gate: pass ⇒ advance; fail ⇒ jump back to `echo`.
  step gate  { kind = :check variable = "last_check" op = :equals value = "ok" target = "echo" }

  step done  { kind = :command command = "echo all gates passed" }
}
