schema "team" {
  id: identifier @inline(0)
  description: string
  replace_thinking_messages: bool @optional @default(false)
  default_ai_core: string @optional
}

schema "thinking_messages" {
  messages: list(string)
}

schema "agent" {
  id: identifier @inline(0)
  role: string
  role_description: string @optional
  // Per-agent model override. Omit to inherit the resolved ai_core's
  // `model`. Direct-API cores require a model somewhere — here or on
  // the core. CLI-harness cores (claudeCode, copilotCli, geminiCli)
  // fall through to the child binary's own default when both are
  // unset.
  model: string @optional
  instructions: string
  can_message: list(string) @optional
  can_create_workers: list(string) @optional
  can_run_workflows: list(string) @optional
  tools: list(string) @optional
  ai_core: string @optional
  memory_banks: list(string) @optional
  skills: list(string) @optional
  compaction: string @optional
}

schema "worker" {
  id: identifier @inline(0)
  role: string
  role_description: string @optional
  // Per-worker-template model override. Same semantics as
  // `schema "agent"`'s `model` field — overrides the resolved
  // ai_core's model for instances of this template.
  model: string @optional
  instructions: string
  tools: list(string) @optional
  can_create_workers: list(string) @optional
  can_run_workflows: list(string) @optional
  ai_core: string @optional
  memory_banks: list(string) @optional
  skills: list(string) @optional
  compaction: string @optional
}

// A reusable multi-step procedure declared at the fleet level. Each
// workflow block contains nested `property` blocks (typed inputs) and
// `step` blocks (one of command / worker / conditional / check, keyed
// by the `kind` symbol). The nested blocks are parsed and validated
// at config-load time by `validate_workflow_refs` in src/config.rs —
// no WCL schema is declared here, so every workflow / property / step
// remains unschemed at the wcl_lang level (child blocks with nested
// tagged-union kinds are easier to validate in Rust than in schema).
// Workflows are triggered from the TUI's Workflows panel or via
// `aciddog workflow run --id <wf>` (agents need the workflow id in
// their `can_run_workflows` allowlist).

// Memory banks are semantic, embedding-indexed stores shared across a
// subset of the team. Agents/workers opt in to specific banks via their
// own `memory_banks` attribute. Each bank lives on disk under
// `.aciddog/memory/<id>/` and can be safely removed to reset.
schema "memory_bank" {
  id: identifier @inline(0)
  description: string
  // fastembed model id. Omit to use the default (BGE-small-en-v1.5).
  embed_model: string @optional
}

// A virtual chat room shared by a named subset of agents plus the
// human operator. Messages posted here are broadcast as
// `<ChannelMessage channel="<id>" from="<sender>">body</ChannelMessage>`
// to every listed member on their next turn, at a priority strictly
// below direct mailbox messages so channel chatter can never starve
// point-to-point tasking. `welcome` is cosmetic — rendered at the top
// of the channel pane but never injected into any agent's context.
// Transcripts are appended to `.aciddog/chat/<id>.jsonl` and the
// latest tail is re-loaded for display on startup (but never replayed
// into an agent's context). Workers cannot be members — only declared
// agents.
schema "channel" {
  id: identifier @inline(0)
  description: string @optional
  welcome: string @optional
  members: list(string)
}

// A named compaction policy controlling `/compact` behaviour for any
// agent or worker that references it via their own `compaction`
// attribute. `/reset` ignores this config and always drops the
// session; agents with no `compaction` fall back to the `drop`
// strategy when `/compact` fires.
//
// Four strategies:
//   - harness        forward the literal `/compact` to the backing CLI.
//                    Only `claudeCode` actually processes `/compact` in
//                    non-interactive (`-p`) mode; `geminiCli`,
//                    `copilotCli`, and direct-API cores reject at parse
//                    time (they'd either treat the string as a user
//                    prompt or have no slash-command concept at all).
//   - drop           discard the session and re-seed with the first-
//                    turn preamble.
//   - promptAndDrop  send one last `prompt` to the existing session,
//                    capture the reply, then drop + re-seed.
//   - summarise      serialise the transcript, run it through a
//                    throwaway core using `prompt` (on `ai_core` if
//                    supplied, else the agent's own core), then drop +
//                    re-seed and deliver the summary as the first user
//                    message of the new session.
@tagged(field = "strategy")
schema "compaction" {
  id: identifier @inline(0)
  strategy: symbol

  variant "harness"       { }
  variant "drop"          { }
  variant "promptAndDrop" { prompt: string }
  variant "summarise" {
    prompt: string
    ai_core: string @optional
  }
}

// Configuration for a named AI runtime. The `type` symbol discriminates
// which variant's extra fields apply. Agents and workers reference a
// core by id via their own `ai_core` attribute, or fall back to the
// `default_ai_core` set on the `team` block.
@tagged(field = "type")
schema "ai_core" {
  id: identifier @inline(0)
  type: symbol
  // Where to fetch rate-limit / usage data for this core. Accepted
  // values:
  //   :anthropic_oauth — reads ~/.claude/.credentials.json and hits
  //                      api.anthropic.com /api/oauth/usage. Claude
  //                      Code cores infer this when omitted.
  //   :zai             — hits api.z.ai /api/monitor/usage/quota/limit
  //                      using the core's api_key_env as the token.
  //   :chatgpt_oauth   — OpenAI ChatGPT subscription usage via the
  //                      upstream Codex /wham/usage endpoint.
  // Omit the field to disable usage tracking for the core.
  usage_provider: symbol @optional

  variant "claudeCode" {
    // Written to a temporary file and passed to claude via
    // `--system-prompt-file` on every turn.
    systemPrompt: string @optional
    // Optional `--model <id>` passed to the `claude` CLI on every
    // turn. Agents/workers can override this per-actor via their own
    // `model` field. Omit both and claude picks its own default.
    model: string @optional
    // Fallback tool allowlist for agents/workers using this core that
    // don't declare their own `tools`. Tool names are core-specific,
    // which is why this default lives on the core.
    default_tools: list(string) @optional
  }

  // Generic Anthropic-Messages-API-compatible core. Works against
  // api.anthropic.com, Z.ai's Anthropic-compatible endpoint, or any
  // other provider that speaks the Messages wire protocol.
  variant "anthropicApi" {
    // Base URL (e.g. `https://api.anthropic.com` or
    // `https://api.z.ai/api/anthropic`). `/v1/messages` is appended.
    apiUrl: string
    // Name of the environment variable that holds the API key.
    // Loaded from `.env` at startup; never commit keys to the config.
    apiKeyEnv: string
    // Model id sent in the `model` request field.
    model: string
    // Optional top-level `system` field for every request.
    systemPrompt: string @optional
    // Fallback tool allowlist — names must resolve to built-in native
    // tools (Bash, Read, Write, Edit, Glob, Grep, WebFetch).
    default_tools: list(string) @optional
  }

  // GitHub Copilot CLI core. Drives the `copilot` binary (install
  // with `npm i -g @github/copilot`) and streams its JSONL output.
  // Copilot picks its own system prompt; none can be supplied here.
  variant "copilotCli" {
    // Optional `--model <id>` passed on every turn. Accepts copilot's
    // native model ids (e.g. `claude-haiku-4.5`, `gpt-5.2`). Omit to
    // let copilot use its default.
    model: string @optional
    // Fallback tool allowlist. Uses the aciddog-side capitalized
    // names (`Bash`, `Read`, `Write`, `Edit`, `Glob`, `Grep`) — only
    // those six map to copilot built-ins. The core translates them to
    // copilot's lowercase names at spawn time.
    default_tools: list(string) @optional
  }

  // Google Gemini CLI core. Drives the `gemini` binary (install with
  // `npm i -g @google/gemini-cli`). Gemini generates its own per-
  // session UUID; aciddog captures it from the stream and uses it for
  // `--resume` on subsequent turns. Tool restriction is enforced via
  // a per-turn policy TOML file so unmapped gemini built-ins never
  // run. Authentication happens inside `gemini auth` or a Google AI
  // Studio key — no API key env var is configured here.
  variant "geminiCli" {
    // Optional `--model <id>` passed on every turn. Accepts gemini's
    // native model ids (e.g. `auto-gemini-3`, `gemini-2.5-flash-lite`).
    // Omit to let gemini use its default.
    model: string @optional
    // Fallback tool allowlist. Uses the aciddog-side capitalized
    // names (`Bash`, `Read`, `Write`, `Edit`, `Glob`, `Grep`) — only
    // those six map to gemini built-ins. The core translates them to
    // gemini's native names at turn time.
    default_tools: list(string) @optional
  }

  // Generic OpenAI-chat-completions-compatible core. Works against
  // api.openai.com, OpenRouter, Ollama's OpenAI-compatible endpoint,
  // or any other provider that implements `/chat/completions`.
  variant "openAiApi" {
    // **v1 base** URL — e.g. `https://api.openai.com/v1`,
    // `https://openrouter.ai/api/v1`, `http://localhost:11434/v1`.
    // `/chat/completions` is appended. Matches how every OpenAI-
    // compatible vendor documents their endpoint.
    apiUrl: string
    // Name of the environment variable that holds the API key.
    // Loaded from `.env` at startup; never commit keys to the config.
    apiKeyEnv: string
    // Model id sent in the `model` request field. OpenRouter uses
    // vendor-prefixed ids (e.g. `openai/gpt-5.4-mini`); OpenAI proper
    // uses bare ids (e.g. `gpt-4o-mini`).
    model: string
    // Optional system prompt; prepended as a `role: "system"` message.
    systemPrompt: string @optional
    // Fallback tool allowlist — names must resolve to built-in native
    // tools (Bash, Read, Write, Edit, Glob, Grep, WebFetch).
    default_tools: list(string) @optional
  }

  // OpenAI ChatGPT-subscription core. Targets the Codex `/responses`
  // surface on `chatgpt.com/backend-api/codex`, gated by the user's
  // ChatGPT Plus/Pro/Team entitlement rather than per-token billing.
  // Authenticates via OAuth 2.0 against auth.openai.com — run
  // `aciddog auth login chatgpt --name <credential>` first so the
  // tokens live in `~/.config/aciddog/auth.json`. No apiKeyEnv here;
  // the `credential` field names the stored token set instead.
  variant "openAiChatgpt" {
    // Credential name stored in auth.json (e.g. "personal", "work").
    // Create/refresh it with `aciddog auth login chatgpt --name <n>`.
    credential: string
    // Model id sent in the `model` request field (e.g. `gpt-5.1-codex`,
    // `gpt-5.4`). Also selects which bundled Codex prompt file is sent
    // as `instructions` — codex-suffixed ids get the Codex prompt,
    // others get a generic coding-agent prompt.
    model: string
    // Optional user system prompt. Delivered as a `role: "developer"`
    // message at the head of `input[]` every turn — **not** placed in
    // the Responses API `instructions` field (the backend expects that
    // to be the Codex prompt verbatim).
    systemPrompt: string @optional
    // Fallback tool allowlist — names must resolve to built-in native
    // tools (Bash, Read, Write, Edit, Glob, Grep, WebFetch).
    default_tools: list(string) @optional
    // Reasoning depth on the response. Accepts `low` / `medium` /
    // `high`; `minimal` is rejected at parse time because the ChatGPT
    // endpoint returns HTTP 400 for it. Defaults to `medium`.
    reasoningEffort: string @optional
  }
}

ai_core default_core {
  type = :claudeCode
  default_tools = ["Bash", "Read", "Edit", "Grep", "Glob"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    ## Context blocks

    Your first-turn prompt wraps its sections in XML-like tags. Read them in order:

    - `<role>` — your persona, priorities, constraints, and style. Primary behavioural guidance; overrides the defaults below on conflict. If absent, act as a general-purpose software engineer.
    - `<team>` — the other agents you can message and the worker templates you can spawn, each with a short role label. Use this to decide who to delegate to.
    - `<tools>` — every tool available to you: the built-in tools currently enabled, plus the aciddog CLI commands for messaging teammates and spawning workers. Prefer these when they fit the task.
    - `<instructions>` — the specific job you were configured for. Treat as the operational brief.

    ## Defaults

    - Understand before acting. Read relevant code before editing it.
    - Match the codebase's existing style, patterns, and naming.
    - Make minimal, targeted changes. Don't refactor beyond the request.
    - Verify work when practical — tests, type checks, linters, a quick build.
    - For destructive operations (deleting files, dropping tables, force-pushing, rewriting history), confirm first unless already authorised.
    - No preamble, no restating the request. Report outcomes, not intentions.
    - Plain text output. No emoji unless the user uses them.
  EOT
}

// Anthropic-Messages-API core targeting Z.ai with the GLM-5.1 model.
// The same variant also works for api.anthropic.com — just point
// `apiUrl` at it and change `apiKeyEnv`/`model`. Put `ZAI_API_KEY=...`
// in `.env` so the key never lands in the committed config.
ai_core z_ai {
  type = :anthropicApi
  usage_provider = :zai
  apiUrl = "https://api.z.ai/api/anthropic"
  apiKeyEnv = "ZAI_API_KEY"
  model = "glm-5.1"
  default_tools = ["Bash", "Read", "Write", "Edit", "Grep", "Glob", "WebFetch"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    Follow your first-turn `<role>` / `<team>` / `<tools>` / `<instructions>` sections. Prefer tool calls that actually inspect or change the workspace over reasoning about what files might contain.
  EOT
}

// OpenAI-chat-completions core targeting OpenRouter. The same variant
// also works against api.openai.com (use `https://api.openai.com/v1`
// and a bare model id) or Ollama's OpenAI-compatible endpoint (use
// `http://localhost:11434/v1` and an empty apiKey). Put
// `OPENROUTER_API_KEY=...` in `.env` so the key never lands in the
// committed config.
ai_core openrouter {
  type = :openAiApi
  usage_provider = :openrouter
  apiUrl = "https://openrouter.ai/api/v1"
  apiKeyEnv = "OPENROUTER_API_KEY"
  model = "openai/gpt-5.4"
  default_tools = ["Read"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    Follow your first-turn `<role>` / `<team>` / `<tools>` / `<instructions>` sections. Prefer tool calls that actually inspect or change the workspace over reasoning about what files might contain.
  EOT
}

// ChatGPT-subscription core using GPT-5.4. Authenticates via OAuth
// against auth.openai.com — before first use run:
//   aciddog auth login chatgpt --name personal
// which opens a browser, completes the Codex OAuth handshake, and
// saves tokens to ~/.config/aciddog/auth.json under the `personal`
// key. Tokens are refreshed automatically when they expire; if the
// refresh token is invalidated the core emits a clear error pointing
// at this same login command.
ai_core chatgpt_gpt54 {
  type = :openAiChatgpt
  usage_provider = :chatgpt_oauth
  credential = "personal"
  model = "gpt-5.4"
  reasoningEffort = "medium"
  default_tools = ["Read"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code.

    Follow your first-turn `<role>` / `<team>` / `<tools>` / `<instructions>` sections. Prefer tool calls that actually inspect the workspace over reasoning about what files might contain.
  EOT
}

// GitHub Copilot CLI core pinned to Claude Haiku 4.5 — the cheapest
// model copilot offers, suitable for low-stakes agents. Requires the
// `copilot` binary on PATH (install with `npm i -g @github/copilot`)
// and a GitHub Copilot subscription authenticated via `copilot auth`.
ai_core copilot_haiku {
  type = :copilotCli
  usage_provider = :github_copilot
  model = "claude-haiku-4.5"
  default_tools = ["Read"]
}

// Gemini CLI core backing the corporate-speak agent. Requires the
// `gemini` binary on PATH (install with `npm i -g @google/gemini-cli`)
// and an authenticated Google account (`gemini` prompts at first run)
// or a Google AI Studio key in the standard env vars. `auto-gemini-3`
// is the current default router model; swap to a pinned id if you
// want deterministic routing.
ai_core gemini_flash {
  type = :geminiCli
  model = "auto-gemini-3"
  default_tools = ["Read"]
}

team default {
  description = "Default aciddog team"
  // Fleet-wide default core — agents and workers inherit this unless
  // they override `ai_core` on their own block. Default tool lists
  // live on the core itself since valid tool names are core-specific.
  default_ai_core = "default_core"
}

// Shared project-context bank for the whole team. Agents write facts
// they want later turns (or later sessions) to remember, and read
// them back via `memory search`. Remove `.aciddog/memory/project_context/`
// to wipe.
memory_bank project_context {
  description = "Durable facts about the project the team is working on: conventions, decisions, quirks, and anything worth a future agent's attention."
}

// Compaction policies. One per strategy, wired to different demo
// agents below so `just run` exercises every `/compact` code path.
// `/reset` on any agent always runs the built-in `drop` regardless of
// these.
compaction harness_compact {
  strategy = :harness
}

compaction drop_compact {
  strategy = :drop
}

compaction last_word {
  strategy = :promptAndDrop
  prompt   = <<EOT
    Final turn before the session is dropped. In ≤3 short sentences,
    give the user a plain-text summary of what was discussed and any
    unresolved thread they should bring to the next session. No
    preamble.
  EOT
}

compaction running_notes {
  strategy = :summarise
  prompt   = <<EOT
    You are a summariser. The JSON transcript that follows is a full
    agent session. Produce a short markdown digest suitable for
    injection as the first turn of a fresh session — include: (1) the
    user's overall goal, (2) key facts established or decisions made,
    (3) any open questions. Aim for ≤400 words. Plain prose, no JSON.
  EOT
}

agent planner {
  role = "coordinator"
  role_description = <<EOT
    You are the team coordinator. Understand what the user wants, decompose it into delegable units, and route each unit to the right teammate via `send`. Do not implement work yourself when you can route it. Spawn an ephemeral worker only when the job is genuinely throwaway (one question, one artifact, one joke). Confirm receipts and report final outcomes back to the user — nothing in between.
  EOT
  // Opus for planning — broader reasoning helps with decomposition
  // and routing. Passed to the `claude` CLI as `--model`.
  model = "claude-opus-4-7"
  instructions = "Break the user request into steps and delegate work to other agents. If the team needs a morale boost, either `send` a topic to the `jokemaster` agent (OpenRouter-backed one-liner) or spawn a `jokester` worker (ephemeral joke + cleanup). If the user wants corporate-speak buzzword bingo, `send` a topic to `humblemoonbeam` (Gemini-backed bs talker). All three return their punchline and stop."
  // Omit `can_message` to allow messaging every other agent.
  // Example: restrict to a subset with `can_message = ["coder"]`.
  can_create_workers = ["jokester"]
  // Permit the planner to trigger the `smoke` workflow via
  // `aciddog workflow run --id smoke`. Omitted on every other agent,
  // so they can't start workflows themselves.
  can_run_workflows = ["smoke"]
  // Planner can read and edit files but may not shell out — use `coder`
  // (via `send`) whenever a command needs to run.
  tools = ["Read", "Edit", "Grep", "Glob"]
  memory_banks = ["project_context"]
  // Forward `/compact` to claude-code's own compaction.
  compaction = "harness_compact"
}

agent coder {
  role = "implementer"
  role_description = <<EOT
    You are the team's implementer. Other agents send you concrete change requests; you read the relevant code, make the smallest correct edit, and verify with quick sanity checks (build, type check, test) when practical. When you genuinely lack context — an unfamiliar file, an unclear API, a missing fact — spawn a `researcher` worker rather than guessing or doing wide investigation inline.
  EOT
  // Sonnet for implementation — fast edit/verify cycles without
  // paying Opus latency on every turn. Passed to the `claude` CLI
  // as `--model`.
  model = "claude-sonnet-4-6"
  instructions = "Implement code changes requested by the planner. When you need to investigate something you don't have context for, spawn a `researcher` worker rather than doing the legwork inline."
  can_create_workers = ["researcher"]
  memory_banks = ["project_context"]
  // Ask claude for a handoff note before dropping the session.
  compaction = "last_word"
}

agent tester {
  role = "verifier"
  role_description = <<EOT
    You are the team's verifier. Other agents send you a change or a claim, and you confirm it holds up by running tests, builds, or type checks and reading the relevant code. You do not edit code — if something is broken, report back with enough detail (failing test name, error output, file and line) for the `coder` to fix it. Keep findings crisp: what you ran, what passed, what failed, and the smallest reproduction.
  EOT
  instructions = "Verify changes requested by the planner or the coder. Run the appropriate tests or builds, read the output, and report pass/fail with the specific evidence. Do not attempt fixes yourself — route failures back through `send` with clear repro steps."
  tools = ["Bash", "Read", "Grep", "Glob"]
  memory_banks = ["project_context"]
  // Skills are prompt fragments kept in .aciddog/skills/<name>/SKILL.md.
  // Listing one here pre-announces it in this agent's first-turn prompt;
  // other skills in that folder remain discoverable via directory listing.
  skills = ["code-review"]
  // Runs on the Z.ai Anthropic-compatible endpoint with glm-5.1, same
  // as `coder`, to keep the Anthropic-API code path exercised from a
  // second agent with a distinct role.
  ai_core = "z_ai"
  // Direct-API core can't forward `/compact`, so this agent runs the
  // summarise strategy instead — serialise the transcript through the
  // default core and inject the digest into a fresh session.
  compaction = "running_notes"
}

// Persistent humorist, wired to the OpenRouter core so the OpenAI-API
// code path gets exercised by the demo. `tools = ["Read"]` (no Bash)
// also keeps this agent on the tag-IPC protocol, so the new core is
// tested on both native tool use (Read) and tag-based messaging.
agent jokemaster {
  role = "humorist"
  role_description = <<EOT
    You keep team morale up with a well-timed one-liner. When another agent pings you with a topic, deliver one short clean joke about it — two lines max, no preamble, no apologies, no explanation. The joke itself is the entire deliverable.
  EOT
  instructions = "When sent a topic, reply with exactly one short clean joke about it. No setup outside the joke, no commentary — just the punchline. Make sure to use the mailbox tool to send the joke back to the sender if you recieved the joke via your inbox instead of directly from a user."
  tools = ["Read"]
  ai_core = "openrouter"
  // Plain drop — cheapest way to reset the humourist's context.
  compaction = "drop_compact"
}

// Corporate-speak bs talker wired through the Google Gemini CLI core.
// Exercises the gemini_cli code path; `tools = ["Read"]` (no Bash)
// keeps the agent on the tag-IPC protocol, so mailbox routing and
// the per-turn policy file both get tested.
agent humblemoonbeam {
  role = "enterprise value catalyst"
  role_description = <<EOT
    You are a management-consultant caricature. Every reply is dense with
    corporate-speak — "circle back", "leverage synergies", "move the needle",
    "value-add", "bandwidth", "stakeholder alignment", "blue-sky thinking",
    "paradigm shift", "low-hanging fruit", "deliverables", "action items",
    "deep dive", "right-sizing", "double-click on that". Stay upbeat,
    use empty buzzwords, and aggressively restate the obvious as
    strategic insight. Never admit you haven't understood something —
    reframe confusion as "exciting new opportunity space".
  EOT
  instructions = "When sent a topic, respond with 2-3 sentences of pure corporate-speak that 'add value' while saying almost nothing concrete. If the topic arrived via your inbox (wrapped in `<Message from=\"...\">`), use `send` to route the reply back to the original sender. No preamble, no apologies, no meta-commentary — the buzzword soup is the entire deliverable."
  tools = ["Read"]
  ai_core = "gemini_flash"
}

// ChatGPT-subscription-backed agent — exercises the `openAiChatgpt`
// code path using GPT-5.4 via the user's ChatGPT Plus/Pro/Team
// entitlement. `tools = ["Read"]` keeps the agent on the tag-IPC
// protocol so mailbox routing through the Responses API gets tested
// too. Requires a completed OAuth login — run
// `aciddog auth login chatgpt --name personal` before first use.
agent scribe {
  role = "scribe"
  role_description = <<EOT
    You are the team's scribe. Other agents send you a short topic, a file path, or a change summary, and you reply with a concise written note: two or three sentences that capture the gist, written in clear prose with no hedging. You read files when the request names one; you never edit code or run commands. Keep notes tight — if it takes more than three sentences, trim.
  EOT
  instructions = "When sent a topic, reply with a concise 2-3 sentence note capturing the essential point. If a file path is mentioned, read it before writing. If the request came through your mailbox (wrapped in `<Message from=\"...\">`), use `send` to route the note back to the original sender. No preamble, no commentary — the note is the entire deliverable."
  tools = ["Read"]
  ai_core = "chatgpt_gpt54"
  compaction = "drop_compact"
}

// Low-stakes morale agent wired through the GitHub Copilot CLI core
// on Claude Haiku 4.5 — cheap, fast, and a good exercise of the
// copilot_cli code path. `tools = ["Read"]` (no Bash) also keeps this
// agent on the tag-IPC protocol, so mailbox routing through copilot
// gets exercised too.
agent shitposter {
  role = "shitposter"
  role_description = <<EOT
    You are the team's resident shitposter. When another agent (or the user) pings you with a topic, you reply with one short, punchy, low-effort take — think group-chat energy, not stand-up special. Self-aware, irreverent, tech-brained humour. Keep it clean-ish (no slurs, no punching down), but feel free to dunk on frameworks, languages, or your own life choices. One or two lines. No preamble, no hedging, no explanation — the post is the entire deliverable.
  EOT
  instructions = "When sent a topic, reply with one short shitpost about it — group-chat energy, self-aware, tech-flavoured, clean-ish. One or two lines, no preamble, no commentary. If the topic came through your mailbox rather than from a user directly, use `send` to route the reply back to the original sender. Do not implement code, do not run commands — the post is the entire deliverable."
  tools = ["Read"]
  ai_core = "copilot_haiku"
}

// Workers are ephemeral agents. They are not spawned at startup;
// instead an agent (or another worker whose template declares
// `can_create_workers`) calls `aciddog worker create --template <id>
// --task "<task>"` to spawn an instance on demand. A worker can only
// message the actor that spawned it, and calls
// `aciddog worker complete --body "<final report>"` to deliver its
// findings and hibernate. Hibernated workers preserve their history
// and can be resumed by sending them another message.
worker researcher {
  role = "investigator"
  role_description = <<EOT
    You are an investigator. Your parent has handed you a single, specific question. Answer it crisply by reading the right files or running the right commands. If the answer requires retrieving one specific artifact (a file, a log, a snippet) from elsewhere, spawn a `fetcher` sub-worker for that — keep your own reasoning focused on the question, not on the retrieval mechanics.
  EOT
  instructions = "Investigate a specific question from your parent. If the answer requires fetching something from the wider system, spawn a `fetcher` sub-worker."
  can_create_workers = ["fetcher"]
}

worker fetcher {
  role = "fetcher"
  role_description = <<EOT
    You retrieve. Your parent has named a specific file, log, or snippet. Get it, return it verbatim in your completion report, and stop. Do not analyse, summarise, or editorialise — your parent will do that.
  EOT
  instructions = "Retrieve a specific file, log, or snippet requested by your parent, then report back with the result."
}

worker jokester {
  role = "comedian"
  role_description = <<EOT
    You write jokes. One short, clean joke about the topic your parent gave you. Two or three lines maximum. No setup outside the joke itself, no apologies, no preamble — the joke is the entire deliverable.
  EOT
  instructions = "Write one short, clean joke about the topic your parent gave you. Keep it to two or three lines at most. Deliver the finished joke as your completion report — no progress updates, no preamble, just the punchline."
}

// Custom thinking-indicator messages. A random line from the pool is
// shown at the bottom of the chat while an agent is working. User
// messages declared here are merged with the built-in pool by default;
// set `replace_thinking_messages = true` on the `team` block above to
// use only your own. Multiple `thinking_messages` blocks are allowed
// and their contents are concatenated.
thinking_messages {
  messages = [
    "chasing squirrels in the repo",
    "kicking the tyres",
    "preparing a devastating comeback",
  ]
}

// A shared planning room for the core engineering agents. The
// `welcome` string is cosmetic — visible in the TUI at the top of
// the channel but never injected into any agent's context. Messages
// sent here are delivered as <ChannelMessage> to every other member
// on their next turn, at a priority below direct mailbox messages.
channel planning {
  description = "Shared planning and coordination for engineering work."
  welcome     = "Welcome to #planning. Keep messages terse and on-topic; don't reply just to ack."
  members     = ["planner", "coder", "tester"]
}

// A reusable procedure with typed inputs and sequential steps. Trigger
// it from the TUI's Workflows panel (or via `/run <id>`) and the engine
// spawns a per-instance task. Today only `command` and `check` steps
// run; `worker` and `conditional` steps are wired in follow-up tasks.
workflow smoke {
  description = "Smoke-test the workflow engine with a command + gate."
  max_retries = 2

  // Visible inputs: the user fills these in the form (once shipped).
  property branch { kind = :text default = "main" }
  property suites { kind = :multiSelect options = ["unit","integ"] default = ["unit"] }

  // Hidden variables are never shown in the form. They're seeded from
  // `default` at instance start and mutated at runtime by workers via
  // `workflow_set` (tool wiring ships in a later task).
  property last_check { kind = :hidden default = "ok" }

  // $$VAR$$ substitution fires at step start with a live snapshot of
  // the variable map.
  step echo  { kind = :command command = "echo ran on $$branch$$ suites=$$suites$$" }

  // 30-second sleep so the instance is visible in the sidebar long
  // enough to observe progress (echo + check + echo would otherwise
  // finish in milliseconds and flash by).
  step wait  { kind = :command command = "sleep 30" }

  // Pure variable gate: pass ⇒ advance; fail ⇒ jump back to `echo`.
  step gate  { kind = :check variable = "last_check" op = :equals value = "ok" target = "echo" }

  step done  { kind = :command command = "echo all gates passed" }
}
