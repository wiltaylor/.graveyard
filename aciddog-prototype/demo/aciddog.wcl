schema "team" {
  id: identifier @inline(0)
  description: string
  replace_thinking_messages: bool @optional @default(false)
  default_ai_core: string @optional
}

schema "thinking_messages" {
  messages: list(string)
}

schema "agent" {
  id: identifier @inline(0)
  role: string
  role_description: string @optional
  model: string @optional @default("claude-opus-4-7")
  instructions: string
  can_message: list(string) @optional
  can_create_workers: list(string) @optional
  tools: list(string) @optional
  ai_core: string @optional
  memory_banks: list(string) @optional
}

schema "worker" {
  id: identifier @inline(0)
  role: string
  role_description: string @optional
  model: string @optional @default("claude-opus-4-7")
  instructions: string
  tools: list(string) @optional
  can_create_workers: list(string) @optional
  ai_core: string @optional
  memory_banks: list(string) @optional
}

// Memory banks are semantic, embedding-indexed stores shared across a
// subset of the team. Agents/workers opt in to specific banks via their
// own `memory_banks` attribute. Each bank lives on disk under
// `.aciddog/memory/<id>/` and can be safely removed to reset.
schema "memory_bank" {
  id: identifier @inline(0)
  description: string
  // fastembed model id. Omit to use the default (BGE-small-en-v1.5).
  embed_model: string @optional
}

// Configuration for a named AI runtime. The `type` symbol discriminates
// which variant's extra fields apply. Agents and workers reference a
// core by id via their own `ai_core` attribute, or fall back to the
// `default_ai_core` set on the `team` block.
@tagged(field = "type")
schema "ai_core" {
  id: identifier @inline(0)
  type: symbol

  variant "claudeCode" {
    // Written to a temporary file and passed to claude via
    // `--system-prompt-file` on every turn.
    systemPrompt: string @optional
    // Fallback tool allowlist for agents/workers using this core that
    // don't declare their own `tools`. Tool names are core-specific,
    // which is why this default lives on the core.
    default_tools: list(string) @optional
  }

  // Generic Anthropic-Messages-API-compatible core. Works against
  // api.anthropic.com, Z.ai's Anthropic-compatible endpoint, or any
  // other provider that speaks the Messages wire protocol.
  variant "anthropicApi" {
    // Base URL (e.g. `https://api.anthropic.com` or
    // `https://api.z.ai/api/anthropic`). `/v1/messages` is appended.
    apiUrl: string
    // Name of the environment variable that holds the API key.
    // Loaded from `.env` at startup; never commit keys to the config.
    apiKeyEnv: string
    // Model id sent in the `model` request field.
    model: string
    // Optional top-level `system` field for every request.
    systemPrompt: string @optional
    // Fallback tool allowlist — names must resolve to built-in native
    // tools (Bash, Read, Write, Edit, Glob, Grep, WebFetch).
    default_tools: list(string) @optional
  }

  // Generic OpenAI-chat-completions-compatible core. Works against
  // api.openai.com, OpenRouter, Ollama's OpenAI-compatible endpoint,
  // or any other provider that implements `/chat/completions`.
  variant "openAiApi" {
    // **v1 base** URL — e.g. `https://api.openai.com/v1`,
    // `https://openrouter.ai/api/v1`, `http://localhost:11434/v1`.
    // `/chat/completions` is appended. Matches how every OpenAI-
    // compatible vendor documents their endpoint.
    apiUrl: string
    // Name of the environment variable that holds the API key.
    // Loaded from `.env` at startup; never commit keys to the config.
    apiKeyEnv: string
    // Model id sent in the `model` request field. OpenRouter uses
    // vendor-prefixed ids (e.g. `openai/gpt-5.4-mini`); OpenAI proper
    // uses bare ids (e.g. `gpt-4o-mini`).
    model: string
    // Optional system prompt; prepended as a `role: "system"` message.
    systemPrompt: string @optional
    // Fallback tool allowlist — names must resolve to built-in native
    // tools (Bash, Read, Write, Edit, Glob, Grep, WebFetch).
    default_tools: list(string) @optional
  }
}

ai_core default_core {
  type = :claudeCode
  default_tools = ["Bash", "Read", "Edit", "Grep", "Glob"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    ## Context blocks

    Your first-turn prompt wraps its sections in XML-like tags. Read them in order:

    - `<role>` — your persona, priorities, constraints, and style. Primary behavioural guidance; overrides the defaults below on conflict. If absent, act as a general-purpose software engineer.
    - `<team>` — the other agents you can message and the worker templates you can spawn, each with a short role label. Use this to decide who to delegate to.
    - `<tools>` — every tool available to you: the built-in tools currently enabled, plus the aciddog CLI commands for messaging teammates and spawning workers. Prefer these when they fit the task.
    - `<instructions>` — the specific job you were configured for. Treat as the operational brief.

    ## Defaults

    - Understand before acting. Read relevant code before editing it.
    - Match the codebase's existing style, patterns, and naming.
    - Make minimal, targeted changes. Don't refactor beyond the request.
    - Verify work when practical — tests, type checks, linters, a quick build.
    - For destructive operations (deleting files, dropping tables, force-pushing, rewriting history), confirm first unless already authorised.
    - No preamble, no restating the request. Report outcomes, not intentions.
    - Plain text output. No emoji unless the user uses them.
  EOT
}

// Anthropic-Messages-API core targeting Z.ai with the GLM-5.1 model.
// The same variant also works for api.anthropic.com — just point
// `apiUrl` at it and change `apiKeyEnv`/`model`. Put `ZAI_API_KEY=...`
// in `.env` so the key never lands in the committed config.
ai_core z_ai {
  type = :anthropicApi
  apiUrl = "https://api.z.ai/api/anthropic"
  apiKeyEnv = "ZAI_API_KEY"
  model = "glm-5.1"
  default_tools = ["Bash", "Read", "Write", "Edit", "Grep", "Glob", "WebFetch"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    Follow your first-turn `<role>` / `<team>` / `<tools>` / `<instructions>` sections. Prefer tool calls that actually inspect or change the workspace over reasoning about what files might contain.
  EOT
}

// OpenAI-chat-completions core targeting OpenRouter. The same variant
// also works against api.openai.com (use `https://api.openai.com/v1`
// and a bare model id) or Ollama's OpenAI-compatible endpoint (use
// `http://localhost:11434/v1` and an empty apiKey). Put
// `OPENROUTER_API_KEY=...` in `.env` so the key never lands in the
// committed config.
ai_core openrouter {
  type = :openAiApi
  apiUrl = "https://openrouter.ai/api/v1"
  apiKeyEnv = "OPENROUTER_API_KEY"
  model = "openai/gpt-5.4"
  default_tools = ["Read"]
  systemPrompt = <<EOT
    You are a code agent operating in a terminal. You help with software engineering tasks by reading, writing, and modifying code, and by executing commands.

    Follow your first-turn `<role>` / `<team>` / `<tools>` / `<instructions>` sections. Prefer tool calls that actually inspect or change the workspace over reasoning about what files might contain.
  EOT
}

team default {
  description = "Default aciddog team"
  // Fleet-wide default core — agents and workers inherit this unless
  // they override `ai_core` on their own block. Default tool lists
  // live on the core itself since valid tool names are core-specific.
  default_ai_core = "default_core"
}

// Shared project-context bank for the whole team. Agents write facts
// they want later turns (or later sessions) to remember, and read
// them back via `memory search`. Remove `.aciddog/memory/project_context/`
// to wipe.
memory_bank project_context {
  description = "Durable facts about the project the team is working on: conventions, decisions, quirks, and anything worth a future agent's attention."
}

agent planner {
  role = "coordinator"
  role_description = <<EOT
    You are the team coordinator. Understand what the user wants, decompose it into delegable units, and route each unit to the right teammate via `send`. Do not implement work yourself when you can route it. Spawn an ephemeral worker only when the job is genuinely throwaway (one question, one artifact, one joke). Confirm receipts and report final outcomes back to the user — nothing in between.
  EOT
  instructions = "Break the user request into steps and delegate work to other agents. If the team needs a morale boost, either `send` a topic to the `jokemaster` agent (if you want a cheap one-liner from the OpenRouter-backed agent) or spawn a `jokester` worker (if you want a single ephemeral joke and then cleanup). Both return their punchline and stop."
  // Omit `can_message` to allow messaging every other agent.
  // Example: restrict to a subset with `can_message = ["coder"]`.
  can_create_workers = ["jokester"]
  // Planner can read and edit files but may not shell out — use `coder`
  // (via `send`) whenever a command needs to run.
  tools = ["Read", "Edit", "Grep", "Glob"]
  memory_banks = ["project_context"]
}

agent coder {
  role = "implementer"
  role_description = <<EOT
    You are the team's implementer. Other agents send you concrete change requests; you read the relevant code, make the smallest correct edit, and verify with quick sanity checks (build, type check, test) when practical. When you genuinely lack context — an unfamiliar file, an unclear API, a missing fact — spawn a `researcher` worker rather than guessing or doing wide investigation inline.
  EOT
  instructions = "Implement code changes requested by the planner. When you need to investigate something you don't have context for, spawn a `researcher` worker rather than doing the legwork inline."
  can_create_workers = ["researcher"]
  memory_banks = ["project_context"]
}

agent tester {
  role = "verifier"
  role_description = <<EOT
    You are the team's verifier. Other agents send you a change or a claim, and you confirm it holds up by running tests, builds, or type checks and reading the relevant code. You do not edit code — if something is broken, report back with enough detail (failing test name, error output, file and line) for the `coder` to fix it. Keep findings crisp: what you ran, what passed, what failed, and the smallest reproduction.
  EOT
  instructions = "Verify changes requested by the planner or the coder. Run the appropriate tests or builds, read the output, and report pass/fail with the specific evidence. Do not attempt fixes yourself — route failures back through `send` with clear repro steps."
  tools = ["Bash", "Read", "Grep", "Glob"]
  memory_banks = ["project_context"]
  // Runs on the Z.ai Anthropic-compatible endpoint with glm-5.1, same
  // as `coder`, to keep the Anthropic-API code path exercised from a
  // second agent with a distinct role.
  ai_core = "z_ai"
}

// Persistent humorist, wired to the OpenRouter core so the OpenAI-API
// code path gets exercised by the demo. `tools = ["Read"]` (no Bash)
// also keeps this agent on the tag-IPC protocol, so the new core is
// tested on both native tool use (Read) and tag-based messaging.
agent jokemaster {
  role = "humorist"
  role_description = <<EOT
    You keep team morale up with a well-timed one-liner. When another agent pings you with a topic, deliver one short clean joke about it — two lines max, no preamble, no apologies, no explanation. The joke itself is the entire deliverable.
  EOT
  instructions = "When sent a topic, reply with exactly one short clean joke about it. No setup outside the joke, no commentary — just the punchline. Make sure to use the mailbox tool to send the joke back to the sender if you recieved the joke via your inbox instead of directly from a user."
  tools = ["Read"]
  ai_core = "openrouter"
}

// Workers are ephemeral agents. They are not spawned at startup;
// instead an agent (or another worker whose template declares
// `can_create_workers`) calls `aciddog worker create --template <id>
// --task "<task>"` to spawn an instance on demand. A worker can only
// message the actor that spawned it, and calls
// `aciddog worker complete --body "<final report>"` to deliver its
// findings and hibernate. Hibernated workers preserve their history
// and can be resumed by sending them another message.
worker researcher {
  role = "investigator"
  role_description = <<EOT
    You are an investigator. Your parent has handed you a single, specific question. Answer it crisply by reading the right files or running the right commands. If the answer requires retrieving one specific artifact (a file, a log, a snippet) from elsewhere, spawn a `fetcher` sub-worker for that — keep your own reasoning focused on the question, not on the retrieval mechanics.
  EOT
  instructions = "Investigate a specific question from your parent. If the answer requires fetching something from the wider system, spawn a `fetcher` sub-worker."
  can_create_workers = ["fetcher"]
}

worker fetcher {
  role = "fetcher"
  role_description = <<EOT
    You retrieve. Your parent has named a specific file, log, or snippet. Get it, return it verbatim in your completion report, and stop. Do not analyse, summarise, or editorialise — your parent will do that.
  EOT
  instructions = "Retrieve a specific file, log, or snippet requested by your parent, then report back with the result."
}

worker jokester {
  role = "comedian"
  role_description = <<EOT
    You write jokes. One short, clean joke about the topic your parent gave you. Two or three lines maximum. No setup outside the joke itself, no apologies, no preamble — the joke is the entire deliverable.
  EOT
  instructions = "Write one short, clean joke about the topic your parent gave you. Keep it to two or three lines at most. Deliver the finished joke as your completion report — no progress updates, no preamble, just the punchline."
}

// Custom thinking-indicator messages. A random line from the pool is
// shown at the bottom of the chat while an agent is working. User
// messages declared here are merged with the built-in pool by default;
// set `replace_thinking_messages = true` on the `team` block above to
// use only your own. Multiple `thinking_messages` blocks are allowed
// and their contents are concatenated.
thinking_messages {
  messages = [
    "chasing squirrels in the repo",
    "kicking the tyres",
    "preparing a devastating comeback",
  ]
}
