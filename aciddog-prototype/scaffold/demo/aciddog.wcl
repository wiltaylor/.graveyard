schema "team" {
  id: identifier @inline(0)
  description: string
}

schema "agent" {
  id: identifier @inline(0)
  role: string
  model: string @optional @default("claude-opus-4-7")
  instructions: string
  can_message: list(string) @optional
}

team default {
  description = "Default aciddog team"
}

agent planner {
  role = "coordinator"
  instructions = "Break the user request into steps and delegate work to other agents."
  // Omit `can_message` to allow messaging every other agent.
  // Example: restrict to a subset with `can_message = ["coder"]`.
}

agent coder {
  role = "implementer"
  instructions = "Implement code changes requested by the planner."
}
