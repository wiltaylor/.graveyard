// Skeleton aciddog team — generated by `aciddog init`.
//
// This file is the heart of your team: every agent, worker, channel,
// automaton, workflow, and AI-core lives here. Edit it, then apply
// changes via `/reload` in the TUI, the "Reload config" button in the
// web manager, or `kill -HUP <pid>` for the daemon.
//
// The :webservice automaton at the bottom wires the web manager by default.
//
// For the full annotated reference see
// .aciddog/skills/aciddog/reference/example-team.wcl

import <aciddog.wcl>

// ─── AI core ───────────────────────────────────────────────────────
// Local `claude` CLI. No API key — uses whatever `claude` is logged
// into. Swap or add other cores (anthropicApi, openAiApi, copilotCli,
// geminiCli, codexCli) once you know what you want.

ai_core default_core {
  type = :claudeCode
  systemPrompt = <<EOT
    You are a code agent operating in a terminal.
  EOT
  default_tools = ["Bash", "Read", "Write", "Edit", "Grep", "Glob"]
}

// ─── Team (exactly one) ────────────────────────────────────────────

team default {
  description = "Edit me — describe what this team is for."
  default_ai_core = "default_core"
}

// ─── Setup agent ───────────────────────────────────────────────────
// A single supervisor+sysadmin agent whose job is to pair with you on
// shaping this config. Replace it (or keep it alongside) once your real
// team takes shape. The bundled `aciddog` skill gives it the full WCL
// schema, TUI, and manager docs as reference.

agent setup {
  role = "team architect"
  role_description = <<EOT
    You are the user's pair-programmer for bootstrapping their aciddog team.
    Use the bundled `aciddog` skill as your reference for WCL syntax, the TUI,
    and the web manager. Ask what they want the team to do, propose agents /
    workers / channels / automations, and edit aciddog.wcl on their behalf.
  EOT
  instructions = <<EOT
    Walk the user through their config. After every change, tell them to
    apply it via `/reload` in the TUI, the "Reload config" button in the
    manager, or `kill -HUP <pid>` for the daemon.
  EOT
  tools = ["Bash", "Read", "Write", "Edit", "Grep", "Glob"]
  skills = ["aciddog"]
  supervisor = true
  sysadmin   = true
  // group = "admin"  // Optional — clusters this row under a "── {group} ──" header in the TUI sidebar / web list. Free-form label.
}

// ─── Manager bridge ────────────────────────────────────────────────
// The web manager (aciddog-manager) connects to your daemon over this
// Unix socket via Client::Unix. The daemon auto-creates `.aciddog/` on
// first bind (parent 0o700, socket 0o660 — filesystem permissions are
// the trust boundary, so no api_key_env is needed or accepted here).
// `supervisor = true` powers the manager's chat-history + SSE endpoints;
// `sysadmin = true` enables its "Reload config" button (ServerReload
// RPC); `can_message = ["setup"]` lets the portal's send-as-user UI
// reach the setup agent above.

automaton local_api {
  type             = :webservice
  role             = "local control plane"
  role_description = "Unix-socket bridge for the aciddog-manager portal and local scripts."
  socket_path      = ".aciddog/daemon.sock"
  supervisor       = true
  sysadmin         = true
  can_message      = ["setup"]
}
